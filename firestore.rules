rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function staff() { return signedIn() && role() in ['receptionist', 'doctor', 'pharmacist', 'admin']; }
    match /users/{userId} { allow read: if signedIn() && (request.auth.uid == userId || role() == 'admin'); allow write: if false; }
    match /visits/{visitId} { allow read: if staff(); allow write: if false; }
    match /patients/{patientId} { allow read: if staff(); allow write: if false; }
    match /doctors/{doctorId} { allow read: if staff(); allow write: if false; }
    match /queues/{queueId} { allow read: if staff(); allow write: if false; }
    match /queueEvents/{queueEventId} { allow read: if staff(); allow write: if false; }
    match /prescriptions/{prescriptionId} { allow read: if staff(); allow write: if false; }
    match /pharmacyOrders/{orderId} { allow read: if staff(); allow write: if false; }
    match /medicines/{medicineId} { allow read: if staff(); allow write: if false; }
    match /notifications/{notificationId} { allow read: if staff(); allow write: if false; }
  }
}
